# Taskling LLM provider API keys
# (OPENMOLT_* names are still honoured as a fallback.)
TASKLING_OPENAI_API_KEY=your-openai-key-here
TASKLING_ANTHROPIC_API_KEY=your-anthropic-key-here
TASKLING_GOOGLE_API_KEY=your-google-key-here

# Taskling MCP server mode (HTTP transport only; stdio needs no token)
# Set this in the environment when running: taskling mcp --http
# TASKLING_MCP_TOKEN=your-long-random-token-here

# Integration API keys (optional - can also be set in code)
TASKLING_NOTION_API_KEY=your-notion-key-here
TASKLING_DISCORD_BOT_TOKEN=your-discord-bot-token-here
TASKLING_SLACK_BOT_TOKEN=your-slack-bot-token-here
TASKLING_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TASKLING_GITHUB_TOKEN=your-github-token-here
TASKLING_STRIPE_API_KEY=your-stripe-key-here
TASKLING_SHOPIFY_ACCESS_TOKEN=your-shopify-token-here
TASKLING_SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
TASKLING_AIRTABLE_API_KEY=your-airtable-key-here
TASKLING_TWILIO_ACCOUNT_SID=your-twilio-sid-here
TASKLING_TWILIO_AUTH_TOKEN=your-twilio-token-here
TASKLING_FAL_API_KEY=your-fal-key-here
TASKLING_AWS_ACCESS_KEY_ID=your-aws-key-id-here
TASKLING_AWS_SECRET_ACCESS_KEY=your-aws-secret-here
TASKLING_AWS_REGION=us-east-1
